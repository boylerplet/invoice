{
  "name": "invoice-studio",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm -r --parallel --filter web --filter server dev",
    "build": "pnpm --filter web build",
    "start": "pnpm --filter server start",
    "test": "pnpm -r test",
    "test:e2e": "playwright test",
    "typecheck": "pnpm -r typecheck && tsc -p scripts/tsconfig.json && tsc -p e2e/tsconfig.json",
    "lint": "pnpm -r lint",
    "format": "prettier --write \"apps/**/*.{ts,tsx}\" \"packages/**/*.{ts,tsx,css}\" \"e2e/**/*.ts\" \"scripts/**/*.ts\" \"*.ts\" README.md",
    "db:migrate": "pnpm --filter server exec tsx src/cli/db-migrate.ts",
    "db:reset": "pnpm --filter server exec tsx src/cli/db-reset.ts",
    "user:create": "pnpm --filter server exec tsx src/cli/user-create.ts",
    "fonts:add": "pnpm --filter @workspace/templates exec tsx scripts/fonts-add.ts",
    "template:shots": "tsx scripts/template-shots.ts",
    "e2e:server": "cross-env DATA_DIR=./.e2e-data PORT=3002 WEB_PORT=5174 pnpm db:reset && cross-env DATA_DIR=./.e2e-data PORT=3002 WEB_PORT=5174 pnpm db:seed && cross-env DATA_DIR=./.e2e-data PORT=3002 WEB_PORT=5174 pnpm -r --parallel --filter web --filter server e2e",
    "db:seed": "pnpm --filter server exec tsx src/cli/db-seed.ts"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@napi-rs/canvas": "^1.0.10",
    "@playwright/test": "^1.63.0",
    "@types/node": "^24.19.1",
    "cross-env": "^10.1.0",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.4.299",
    "prettier": "^3.9.9",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "rimraf": "^6.1.3",
    "tsx": "^4.23.15",
    "typescript": "~6.0.2"
  },
  "packageManager": "pnpm@12.9.1",
  "engines": {
    "node": ">=20.19.0"
  }
}
